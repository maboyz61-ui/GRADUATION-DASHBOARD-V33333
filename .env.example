# Compose-level environment. Copy to .env and edit before `docker compose up`.

# Postgres
POSTGRES_USER=ukzn
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ukzn

# API
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=http://localhost:8080

# Storage: local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PayFast
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=http://localhost:8080/api/v1/payments/payfast/itn
PAYFAST_RETURN_URL=http://localhost:8080/purchases
