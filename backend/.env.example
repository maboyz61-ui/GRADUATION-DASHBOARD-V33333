# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=*

# Database: sqlite (dev/test) | postgres (production)
DATABASE_DRIVER=sqlite
DATABASE_URL=./data/dev.db
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://ukzn:ukzn@localhost:5432/ukzn

# Auth
JWT_SECRET=change-me-to-a-32-character-random-string
JWT_EXPIRES_IN_SECONDS=43200
ACCESS_CODE_TTL_SECONDS=300
OIDC_ISSUER=https://sso.ukzn.ac.za
OIDC_CLIENT_ID=ukzn-photo-portal
OIDC_CLIENT_SECRET=

# Storage: local (dev) | s3 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/media
# STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=af-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL=900

# PayFast
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_RETURN_URL=http://localhost:5173/purchases
PAYFAST_CANCEL_URL=http://localhost:5173/purchases
PAYFAST_NOTIFY_URL=http://localhost:3001/api/v1/payments/payfast/itn
